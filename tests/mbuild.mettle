import "mbuild/api";

// Test programs for telemetry. They are a separate package that depends on
// telemetry by path. Run them from the telemetry root with
// `mbuild test-programs`.
fn project() {
  mb_package("telemetry_tests", "0.1.0");
  mb_bin("t_core", "t_core.mettle");
  mb_bin("t_span", "t_span.mettle");
  mb_bin("t_stress", "t_stress.mettle");
  mb_bin("b_execute", "b_execute.mettle");
}

fn deps() {
  mb_dep_path("telemetry", "..");
}
